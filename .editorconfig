# EditorConfig configuration
# https://editorconfig.org/

root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = off

[*.properties]
charset = latin1

[*.{json,toml,yaml,yml}]
indent_size = 2

[*.{bat,cmd}]
end_of_line = crlf
